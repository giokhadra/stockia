@model List<Stockia.Web.Domain.Company>
@{ ViewData["Title"] = "Companies"; }
<div class="page">
    <h1>Companies</h1>
    <a class="btn-link" asp-action="Create">+ New company</a>

    @if (Model.Count == 0)
    {
        <p class="empty-text">No companies yet.</p>
    }
    else
    {
        <table class="data-table">
            <thead><tr><th>Name</th><th>Tax number</th><th>Base currency</th></tr></thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr><td>@c.Name</td><td>@c.TaxNumber</td><td>@c.BaseCurrency</td></tr>
            }
            </tbody>
        </table>
    }
</div>