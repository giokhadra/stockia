@model List<Stockia.Web.Domain.AuditLog>
@{ ViewData["Title"] = "Audit log"; }
<main class="page">
  <p>
    <a asp-controller="Home" asp-action="Index">Home</a> |
    <a asp-controller="Journal" asp-action="New">New journal entry</a> |
    <a asp-controller="Ledger" asp-action="Index">Ledgers</a>
  </p>
  <h1 class="brand">Audit log</h1>

  @if (Model.Count == 0)
  {
    <p class="empty-text">Nothing has been recorded yet.</p>
  }
  else
  {
    <p class="empty-text">The latest @Model.Count lines, newest first. Times are UTC.</p>
    <div class="grid-wrap">
      <table class="grid">
        <thead><tr><th>When</th><th>Who</th><th>What</th><th>Entry</th><th>Details</th></tr></thead>
        <tbody>
          @foreach (var line in Model)
          {
            <tr>
              <td>@line.LogTime.ToString("yyyy-MM-dd HH:mm")</td>
              <td>@line.User?.DisplayName</td>
              <td>@line.Action</td>
              <td>
                @if (line.EntryId is int entryId)
                {
                  <a asp-controller="Journal" asp-action="Details" asp-route-id="@entryId">Entry @entryId</a>
                }
              </td>
              <td>@line.Details</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</main>