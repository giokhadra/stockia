@model List<Stockia.Web.Domain.PurchaseInvoice>
@{ ViewData["Title"] = "Purchase invoices"; }
<div class="page">
    <h1>Purchase invoices</h1>
    <p><a asp-action="New">New purchase invoice</a></p>

    @if (Model.Count == 0)
    {
        <p class="empty-text">No purchase invoices yet.</p>
    }
    else
    {
        <table class="data-table">
            <thead><tr><th>Date</th><th>Number</th><th>Supplier</th><th>Due</th><th>Total</th><th></th></tr></thead>
            <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <td>@i.Date.ToString("yyyy-MM-dd")</td>
                    <td>@i.Number</td>
                    <td>@i.Partner?.Name</td>
                    <td>@i.DueDate.ToString("yyyy-MM-dd")</td>
                    <td>@i.Total.ToString("N2") @i.Currency</td>
                    <td><a asp-action="Details" asp-route-id="@i.Id">Open</a></td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
