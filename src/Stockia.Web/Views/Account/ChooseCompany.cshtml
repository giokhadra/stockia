@model ChooseCompanyViewModel
@{ ViewData["Title"] = "Choose company"; }
<main class="login-wrap">
  <section class="login-card">
    <h1 class="brand">Stockia</h1>
    <p class="tagline">Choose a company</p>

    @if (Model.Assignments.Count == 0)
    {
      <div class="error" role="alert">No company is assigned to your account. Ask an administrator.</div>
    }
    else
    {
      <p>Signed in as @User.Identity?.Name</p>
      <form method="post" asp-controller="Account" asp-action="ChooseCompany">
        <label for="CompanyId">Company</label>
        <select id="CompanyId" name="CompanyId">
          @foreach (var a in Model.Assignments)
          {
            <option value="@a.CompanyId">@a.Company?.Name (@a.Role?.Name)</option>
          }
        </select>
        <button type="submit">Continue</button>
      </form>
    }

    <form method="post" asp-controller="Account" asp-action="Logout">
      <button type="submit" class="btn-link">Sign out</button>
    </form>
  </section>
</main>
