@model JournalNewViewModel
@using System.Globalization
@{
    ViewData["Title"] = "New journal entry";
    string Amt(decimal? v) => v.HasValue && v.Value != 0 ? v.Value.ToString("0.00", CultureInfo.InvariantCulture) : "";
}
<main class="page">
  <p><a asp-controller="Home" asp-action="Index">Home</a> | <a asp-controller="Ledger" asp-action="Index">Ledgers</a></p>
  <h1 class="brand">New journal entry</h1>

  @if (Model.Errors.Count > 0)
  {
    <div class="error" role="alert">
      <ul>
        @foreach (var message in Model.Errors)
        {
          <li>@message</li>
        }
      </ul>
    </div>
  }

  @if (Model.Accounts.Count == 0)
  {
    <div class="error" role="alert">
      <p>There are no active accounts yet. Add them in the <a asp-controller="Accounts" asp-action="Index">chart of accounts</a> first.</p>
    </div>
  }

  <form method="post">
    <label for="Date">Date</label>
    <input id="Date" name="Date" type="date" value="@Model.Form.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" required />

    <label for="Reference">Reference</label>
    <input id="Reference" name="Reference" value="@Model.Form.Reference" maxlength="50" required />

    <label for="Description">Description</label>
    <input id="Description" name="Description" value="@Model.Form.Description" maxlength="500" />

    <div class="grid-wrap">
      <table class="grid">
        <thead>
          <tr><th>Account</th><th class="num">Debit</th><th class="num">Credit</th></tr>
        </thead>
        <tbody id="lines">
          @for (var i = 0; i < Model.Form.Lines.Count; i++)
          {
            var line = Model.Form.Lines[i];
            <tr>
              <td>
                <select name="Lines[@i].AccountId" aria-label="Account, line @(i + 1)">
                  <option value="0">Select account</option>
                  @foreach (var a in Model.Accounts)
                  {
                    <option value="@a.Id" selected="@(a.Id == line.AccountId)">@a.Code - @a.Name</option>
                  }
                </select>
              </td>
              <td><input name="Lines[@i].Debit" type="number" step="0.01" min="0" value="@Amt(line.Debit)" aria-label="Debit, line @(i + 1)" /></td>
              <td><input name="Lines[@i].Credit" type="number" step="0.01" min="0" value="@Amt(line.Credit)" aria-label="Credit, line @(i + 1)" /></td>
            </tr>
          }
        </tbody>
      </table>
    </div>

    <template id="line-template">
      <tr>
        <td>
          <select name="Lines[__i__].AccountId" aria-label="Account, new line">
            <option value="0">Select account</option>
            @foreach (var a in Model.Accounts)
            {
              <option value="@a.Id">@a.Code - @a.Name</option>
            }
          </select>
        </td>
        <td><input name="Lines[__i__].Debit" type="number" step="0.01" min="0" aria-label="Debit, new line" /></td>
        <td><input name="Lines[__i__].Credit" type="number" step="0.01" min="0" aria-label="Credit, new line" /></td>
      </tr>
    </template>

    <button type="button" id="add-line" class="inline-btn">Add line</button>
    <button type="submit">Save entry</button>
  </form>
</main>

<script>
  (function () {
    var body = document.getElementById('lines');
    var template = document.getElementById('line-template').innerHTML;
    var next = body.rows.length;
    document.getElementById('add-line').addEventListener('click', function () {
      body.insertAdjacentHTML('beforeend', template.replace(/__i__/g, next));
      next++;
    });
  })();
</script>
