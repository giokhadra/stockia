@model JournalNewViewModel
@using System.Globalization
@{
    ViewData["Title"] = "New journal entry";
    string Amt(decimal? v) => v.HasValue && v.Value != 0 ? v.Value.ToString("0.00", CultureInfo.InvariantCulture) : "";
    string RateText(decimal? v) => v?.ToString("0.##########", CultureInfo.InvariantCulture) ?? "";
    // BRD OI-1: the stored rates, so the page proposes the last rate on or before the entry date
    var rates = Model.Rates.Select(r => new { c = r.Currency, d = r.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture), r = r.Rate });
}
<main class="page">
  <p><a asp-controller="Home" asp-action="Index">Home</a> | <a asp-controller="Ledger" asp-action="Index">Ledgers</a></p>
  <h1 class="brand">New journal entry</h1>

  @if (Model.Errors.Count > 0)
  {
    <div class="error" role="alert">
      <ul>
        @foreach (var message in Model.Errors)
        {
          <li>@message</li>
        }
      </ul>
    </div>
  }

  @if (Model.Accounts.Count == 0)
  {
    <div class="error" role="alert">
      <p>There are no active accounts yet. Add them in the <a asp-controller="Accounts" asp-action="Index">chart of accounts</a> first.</p>
    </div>
  }

  <form method="post">
    <label for="Date">Date</label>
    <input id="Date" name="Date" type="date" value="@Model.Form.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" required />

    <label for="Reference">Reference</label>
    <input id="Reference" name="Reference" value="@Model.Form.Reference" maxlength="50" required />

    <label for="Description">Description</label>
    <input id="Description" name="Description" value="@Model.Form.Description" maxlength="500" />

    <p class="empty-text">Amounts are in the currency of their line. A line in another currency is converted to
      @Model.BaseCurrency at the rate you type; left blank, the last rate on or before the entry date is used (shown in grey,
      from the <a asp-controller="ExchangeRates" asp-action="Index">exchange rates</a>).</p>

    <div class="grid-wrap">
      <table class="grid" id="lines-table" data-rates='@Json.Serialize(rates)'>
        <thead>
          <tr><th>Account</th><th>Currency</th><th class="num">Rate</th><th class="num">Debit</th><th class="num">Credit</th></tr>
        </thead>
        <tbody id="lines">
          @for (var i = 0; i < Model.Form.Lines.Count; i++)
          {
            var line = Model.Form.Lines[i];
            <tr>
              <td>
                <select name="Lines[@i].AccountId" aria-label="Account, line @(i + 1)">
                  <option value="0">Select account</option>
                  @foreach (var a in Model.Accounts)
                  {
                    <option value="@a.Id" selected="@(a.Id == line.AccountId)">@a.Code - @a.Name</option>
                  }
                </select>
              </td>
              <td>
                <select name="Lines[@i].Currency" aria-label="Currency, line @(i + 1)">
                  <option value="">@Model.BaseCurrency</option>
                  @foreach (var c in Model.Currencies)
                  {
                    <option value="@c" selected="@(string.Equals(c, line.Currency, StringComparison.OrdinalIgnoreCase))">@c</option>
                  }
                </select>
              </td>
              <td><input name="Lines[@i].Rate" class="rate" type="number" step="any" min="0" value="@RateText(line.Rate)" aria-label="Rate, line @(i + 1)" /></td>
              <td><input name="Lines[@i].Debit" type="number" step="0.01" min="0" value="@Amt(line.Debit)" aria-label="Debit, line @(i + 1)" /></td>
              <td><input name="Lines[@i].Credit" type="number" step="0.01" min="0" value="@Amt(line.Credit)" aria-label="Credit, line @(i + 1)" /></td>
            </tr>
          }
        </tbody>
      </table>
    </div>

    <template id="line-template">
      <tr>
        <td>
          <select name="Lines[__i__].AccountId" aria-label="Account, new line">
            <option value="0">Select account</option>
            @foreach (var a in Model.Accounts)
            {
              <option value="@a.Id">@a.Code - @a.Name</option>
            }
          </select>
        </td>
        <td>
          <select name="Lines[__i__].Currency" aria-label="Currency, new line">
            <option value="">@Model.BaseCurrency</option>
            @foreach (var c in Model.Currencies)
            {
              <option value="@c">@c</option>
            }
          </select>
        </td>
        <td><input name="Lines[__i__].Rate" class="rate" type="number" step="any" min="0" aria-label="Rate, new line" /></td>
        <td><input name="Lines[__i__].Debit" type="number" step="0.01" min="0" aria-label="Debit, new line" /></td>
        <td><input name="Lines[__i__].Credit" type="number" step="0.01" min="0" aria-label="Credit, new line" /></td>
      </tr>
    </template>

    <button type="button" id="add-line" class="inline-btn">Add line</button>
    <button type="submit">Save entry</button>
  </form>
</main>

<script>
  (function () {
    var body = document.getElementById('lines');
    var template = document.getElementById('line-template').innerHTML;
    var next = body.rows.length;
    document.getElementById('add-line').addEventListener('click', function () {
      body.insertAdjacentHTML('beforeend', template.replace(/__i__/g, next));
      next++;
      proposeAll();
    });

    // BRD OI-1: propose the last rate on or before the entry date for each foreign line (as the hint of the
    // Rate box; a blank box uses that rate, a typed one replaces it)
    var rates = JSON.parse(document.getElementById('lines-table').getAttribute('data-rates') || '[]');
    var date = document.querySelector('[name="Date"]');
    function propose(row) {
      var currency = row.querySelector('select[name$=".Currency"]').value;
      var box = row.querySelector('input.rate');
      var best = null;
      rates.forEach(function (r) {
        if (r.c === currency && (!date.value || r.d <= date.value) && (!best || r.d > best.d)) best = r;
      });
      box.disabled = !currency;
      box.placeholder = currency ? (best ? String(best.r) : 'type the rate') : '';
    }
    function proposeAll() { Array.prototype.forEach.call(body.rows, propose); }
    body.addEventListener('change', function (e) { if (e.target.name && /\.Currency$/.test(e.target.name)) propose(e.target.closest('tr')); });
    date.addEventListener('change', proposeAll);
    proposeAll();
  })();
</script>
