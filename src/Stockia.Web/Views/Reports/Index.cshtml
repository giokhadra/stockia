@model Stockia.Web.Controllers.ReportsPageViewModel
@using Stockia.Web.Services
@{
    ViewData["Title"] = "Financial statements";
    string Amt(decimal v) => v == 0 ? "" : v.ToString("N2");
    var s = Model.Statements;
}
<main class="page">
  <p>
    <a asp-controller="Home" asp-action="Index">Home</a> |
    <a asp-controller="Ledger" asp-action="Index">Ledgers</a> |
    <a asp-controller="Journal" asp-action="New">New journal entry</a>
  </p>
  <h1 class="brand">Financial statements</h1>

  <form method="get" asp-action="Index" class="card-form">
    <label>From <input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" /></label>
    <label>To <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" /></label>
    <div class="form-actions"><button type="submit">Show</button></div>
  </form>

  @if (Model.Error is not null) { <p class="error-text" id="report-error">@Model.Error</p> }

  @if (s is not null)
  {
    <h2>Trial balance</h2>
    <p class="empty-text">Movements from @s.From.ToString("yyyy-MM-dd") to @s.To.ToString("yyyy-MM-dd"), in the base currency.</p>
    @if (!s.TrialBalanceBalances)
    {
      <p class="error-text" id="trial-balance-error">The trial balance is out of balance by @((s.TotalDebit - s.TotalCredit).ToString("N2")). Check the journal entries of this period.</p>
    }
    @if (s.TrialBalance.Count == 0)
    {
      <p class="empty-text">No entries in this period.</p>
    }
    else
    {
      <div class="grid-wrap">
        <table class="grid" id="trial-balance">
          <thead><tr><th>Account</th><th>Type</th><th class="num">Debit</th><th class="num">Credit</th><th class="num">Balance</th></tr></thead>
          <tbody>
            @foreach (var l in s.TrialBalance)
            {
              <tr>
                <td><a asp-controller="Ledger" asp-action="Account" asp-route-id="@l.AccountId">@l.Code - @l.Name</a></td>
                <td>@l.Type</td>
                <td class="num">@Amt(l.Debit)</td>
                <td class="num">@Amt(l.Credit)</td>
                <td class="num">@(l.Balance >= 0 ? l.Balance.ToString("N2") + " Dr" : (-l.Balance).ToString("N2") + " Cr")</td>
              </tr>
            }
          </tbody>
          <tfoot>
            <tr><td colspan="2">Total</td><td class="num" id="tb-debit">@s.TotalDebit.ToString("N2")</td><td class="num" id="tb-credit">@s.TotalCredit.ToString("N2")</td><td></td></tr>
          </tfoot>
        </table>
      </div>
    }

    <h2>Income statement</h2>
    <p class="empty-text">From @s.From.ToString("yyyy-MM-dd") to @s.To.ToString("yyyy-MM-dd").</p>
    <div class="grid-wrap">
      <table class="grid" id="income-statement">
        <tbody>
          <tr><th colspan="2">Revenue</th></tr>
          @foreach (var l in s.Revenues) { <tr><td>@l.Code - @l.Name</td><td class="num">@l.Amount.ToString("N2")</td></tr> }
          <tr><td>Total revenue</td><td class="num">@s.TotalRevenue.ToString("N2")</td></tr>
          <tr><th colspan="2">Expenses</th></tr>
          @foreach (var l in s.Expenses) { <tr><td>@l.Code - @l.Name</td><td class="num">@l.Amount.ToString("N2")</td></tr> }
          <tr><td>Total expenses</td><td class="num">@s.TotalExpenses.ToString("N2")</td></tr>
        </tbody>
        <tfoot>
          <tr><td>@(s.NetIncome >= 0 ? "Net profit" : "Net loss")</td><td class="num" id="net-income">@s.NetIncome.ToString("N2")</td></tr>
        </tfoot>
      </table>
    </div>

    <h2>Balance sheet</h2>
    <p class="empty-text">At @s.To.ToString("yyyy-MM-dd").</p>
    @if (!s.BalanceSheetBalances)
    {
      <p class="error-text" id="balance-sheet-error">The balance sheet does not balance. Check that every account has the right type.</p>
    }
    <div class="grid-wrap">
      <table class="grid" id="balance-sheet">
        <tbody>
          <tr><th colspan="2">Assets</th></tr>
          @foreach (var l in s.Assets) { <tr><td>@l.Code - @l.Name</td><td class="num">@l.Amount.ToString("N2")</td></tr> }
          <tr><td>Total assets</td><td class="num" id="total-assets">@s.TotalAssets.ToString("N2")</td></tr>
          <tr><th colspan="2">Liabilities</th></tr>
          @foreach (var l in s.Liabilities) { <tr><td>@l.Code - @l.Name</td><td class="num">@l.Amount.ToString("N2")</td></tr> }
          <tr><td>Total liabilities</td><td class="num">@s.TotalLiabilities.ToString("N2")</td></tr>
          <tr><th colspan="2">Equity</th></tr>
          @foreach (var l in s.Equity) { <tr><td>@l.Code - @l.Name</td><td class="num">@l.Amount.ToString("N2")</td></tr> }
          <tr><td>Result not yet closed (revenue minus expenses to this date)</td><td class="num">@s.ResultToDate.ToString("N2")</td></tr>
          <tr><td>Total equity</td><td class="num">@((s.TotalEquity + s.ResultToDate).ToString("N2"))</td></tr>
        </tbody>
        <tfoot>
          <tr><td>Total liabilities and equity</td><td class="num" id="total-liabilities-equity">@s.TotalLiabilitiesAndEquity.ToString("N2")</td></tr>
        </tfoot>
      </table>
    </div>
  }
</main>