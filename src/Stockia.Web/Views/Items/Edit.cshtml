@model Stockia.Web.Controllers.ItemsPageViewModel
@{ ViewData["Title"] = "Edit item"; }
<div class="page">
    <h1>Edit item @Model.Code</h1>
    <form class="card-form" asp-action="Edit" method="post">
        @if (Model.Error is not null) { <p class="error-text">@Model.Error</p> }
        <input type="hidden" asp-for="Id" />
        <label>Name <input asp-for="Name" /></label>
        <label>Unit <input asp-for="Unit" /></label>
        <label>Category (optional) <input asp-for="Category" /></label>
        <label>Cost <input asp-for="Cost" type="number" step="0.01" min="0" /></label>
        <label>Sale price <input asp-for="SalePrice" type="number" step="0.01" min="0" /></label>
        <label>VAT rate (%) <input asp-for="VatRate" type="number" step="0.01" min="0" max="100" /></label>
        <label>Kind
            <select asp-for="IsStock" asp-items="@(new[] { new SelectListItem("Stock item", "true"), new SelectListItem("Service", "false") })"></select>
        </label>
        <div class="form-actions">
            <button type="submit">Save</button>
            <a asp-action="Index">Cancel</a>
        </div>
    </form>
</div>