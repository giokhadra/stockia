@model Stockia.Web.Controllers.ItemsPageViewModel
@{ ViewData["Title"] = "Items"; }
<div class="page">
    <h1>Items</h1>

    <form class="card-form" asp-action="Create" method="post">
        @if (Model.Error is not null) { <p class="error-text">@Model.Error</p> }
        <label>Code <input asp-for="Code" /></label>
        <label>Name <input asp-for="Name" /></label>
        <label>Unit (bag, kg, trip...) <input asp-for="Unit" /></label>
        <label>Category (optional) <input asp-for="Category" /></label>
        <label>Cost <input asp-for="Cost" type="number" step="0.01" min="0" /></label>
        <label>Sale price <input asp-for="SalePrice" type="number" step="0.01" min="0" /></label>
        <label>VAT rate (%) <input asp-for="VatRate" type="number" step="0.01" min="0" max="100" /></label>
        <label>Kind
            <select asp-for="IsStock" asp-items="@(new[] { new SelectListItem("Stock item", "true"), new SelectListItem("Service", "false") })"></select>
        </label>
        <div class="form-actions"><button type="submit">Add item</button></div>
    </form>

    @if (Model.Items.Count == 0)
    {
        <p class="empty-text">No items yet.</p>
    }
    else
    {
        <table class="data-table">
            <thead><tr><th>Code</th><th>Name</th><th>Unit</th><th>Category</th><th>Cost</th><th>Sale price</th><th>VAT %</th><th>Kind</th><th></th></tr></thead>
            <tbody>
            @foreach (var i in Model.Items)
            {
                <tr>
                    <td>@i.Code</td>
                    <td>@i.Name</td>
                    <td>@i.Unit</td>
                    <td>@i.Category</td>
                    <td>@i.Cost.ToString("N2")</td>
                    <td>@i.SalePrice.ToString("N2")</td>
                    <td>@i.VatRate.ToString("0.##")</td>
                    <td>@(i.IsStock ? "Stock item" : "Service")</td>
                   <td id="stock-@i.Id">@(i.IsStock ? Model.InStock.GetValueOrDefault(i.Id).ToString("N2") : "")</td>
                    <td><a asp-action="Edit" asp-route-id="@i.Id">Edit</a></td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>