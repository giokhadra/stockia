@{ ViewData["Title"] = "Home"; }
<main class="login-wrap">
  <section class="login-card">
    <h1 class="brand">Stockia</h1>
    <p id="welcome">Welcome, @User.Identity?.Name</p>
    <nav class="link-list">
      <a asp-controller="Accounts" asp-action="Index">Chart of accounts</a>
      <a asp-controller="Journal" asp-action="New">New journal entry</a>
      <a asp-controller="Ledger" asp-action="Index">Ledgers</a>
      <a asp-controller="ExchangeRates" asp-action="Index">Exchange rates</a>
      <a asp-controller="Items" asp-action="Index">Items</a>
      <a asp-controller="Warehouses" asp-action="Index">Warehouses</a>
     <a asp-controller="Suppliers" asp-action="Index">Suppliers</a>
      <a asp-controller="PurchaseInvoices" asp-action="Index">Purchase invoices</a>
      <a asp-controller="Receipts" asp-action="Index">Customer receipts</a>
            <a asp-controller="Reports" asp-action="Index">Financial statements</a>
      <a asp-controller="Audit" asp-action="Index">Audit log</a>
    </nav>
    <a class="btn-link" asp-controller="Account" asp-action="ChooseCompany">Switch company</a>
    <form method="post" asp-controller="Account" asp-action="Logout">
      <button type="submit">Sign out</button>
    </form>
  </section>
</main>