@model Stockia.Web.Controllers.AccountsPageViewModel
@using Stockia.Web.Services
@{ ViewData["Title"] = "Chart of accounts"; }
<div class="page">
    <h1>Chart of accounts</h1>

    <form class="card-form" asp-action="Create" method="post">
        @if (Model.Error is not null) { <p class="error-text">@Model.Error</p> }
        <label>Code <input asp-for="Code" /></label>
        <label>Name <input asp-for="Name" /></label>
        <label>Type
            <select asp-for="Type" asp-items="@(new SelectList(AccountService.Types))"></select>
        </label>
        <label>Parent account (optional)
                 <select asp-for="ParentId" asp-items="@(Model.Accounts.Select(a => new SelectListItem(a.Code + " - " + a.Name, a.Id.ToString())))">
                <option value="">(none)</option>
            </select>
        </label>
        <div class="form-actions"><button type="submit">Add account</button></div>
    </form>

    @if (Model.Accounts.Count == 0)
    {
        <p class="empty-text">No accounts yet.</p>
    }
    else
    {
        <table class="data-table">
            <thead><tr><th>Code</th><th>Name</th><th>Type</th><th>Parent</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var a in Model.Accounts)
            {
                <tr>
                    <td>@a.Code</td>
                    <td>@a.Name</td>
                    <td>@a.Type</td>
                    <td>@Model.Accounts.FirstOrDefault(p => p.Id == a.ParentId)?.Code</td>
                    <td>@(a.IsActive ? "Active" : "Inactive")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@a.Id">Edit</a>
                        <form asp-action="SetActive" method="post" style="display:inline">
                            <input type="hidden" name="id" value="@a.Id" />
                            <input type="hidden" name="active" value="@(a.IsActive ? "false" : "true")" />
                            <button type="submit" style="width:auto;margin:0;padding:4px 12px">@(a.IsActive ? "Deactivate" : "Activate")</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>