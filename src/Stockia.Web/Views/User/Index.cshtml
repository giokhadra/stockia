@model Stockia.Web.Controllers.UsersPageViewModel
@{ ViewData["Title"] = "Users and roles"; }
<div class="page">
    <h1>Users and roles</h1>

    <form class="card-form" asp-action="Assign" method="post">
        @if (Model.Error is not null) { <p class="error-text">@Model.Error</p> }
        <label>User
            <select asp-for="UserId" asp-items="@(new SelectList(Model.Users, "Id", "DisplayName"))"></select>
        </label>
        <label>Company
            <select asp-for="CompanyId" asp-items="@(new SelectList(Model.Companies, "Id", "Name"))"></select>
        </label>
        <label>Role
            <select asp-for="RoleId" asp-items="@(new SelectList(Model.Roles, "Id", "Name"))"></select>
        </label>
        <div class="form-actions"><button type="submit">Assign</button></div>
    </form>

    @if (Model.Assignments.Count == 0)
    {
        <p class="empty-text">No assignments yet.</p>
    }
    else
    {
        <table class="data-table">
            <thead><tr><th>User</th><th>Company</th><th>Role</th><th>Since</th></tr></thead>
            <tbody>
            @foreach (var a in Model.Assignments)
            {
                <tr><td>@a.User?.DisplayName</td><td>@a.Company?.Name</td><td>@a.Role?.Name</td><td>@a.Since</td></tr>
            }
            </tbody>
        </table>
    }
</div>