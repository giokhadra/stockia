@model List<Stockia.Web.Domain.CustomerReceipt>
@{ ViewData["Title"] = "Customer receipts"; }
<div class="page">
    <h1>Customer receipts</h1>
    <p><a asp-controller="Home" asp-action="Index">Home</a> | <a asp-action="New">New receipt</a></p>

    @if (Model.Count == 0)
    {
        <p class="empty-text">No receipts yet.</p>
    }
    else
    {
        <table class="data-table">
            <thead><tr><th>Date</th><th>Number</th><th>Customer</th><th>Method</th><th>Amount</th><th></th></tr></thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Date.ToString("yyyy-MM-dd")</td>
                    <td>@r.Number</td>
                    <td>@r.Partner?.Name</td>
                    <td>@r.Method</td>
                    <td>@r.Amount.ToString("N2") @r.Currency</td>
                    <td><a asp-action="Details" asp-route-id="@r.Id">Open</a></td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
