@model List<Account>
@using Stockia.Web.Domain
@{ ViewData["Title"] = "Ledgers"; }
<main class="page">
  <p>
    <a asp-controller="Home" asp-action="Index">Home</a> |
    <a asp-controller="Journal" asp-action="New">New journal entry</a>
  </p>
  <h1 class="brand">Ledgers</h1>
  <div class="grid-wrap">
    <table class="grid">
      <thead><tr><th>Code</th><th>Account</th></tr></thead>
      <tbody>
        @foreach (var a in Model)
        {
          <tr>
            <td>@a.Code</td>
            <td><a asp-controller="Ledger" asp-action="Account" asp-route-id="@a.Id">@a.Name</a>@(a.IsActive ? "" : " (inactive)")</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</main>
