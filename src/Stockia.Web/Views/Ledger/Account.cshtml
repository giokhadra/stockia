@model AccountLedger
@using Stockia.Web.Services
@{
    ViewData["Title"] = "Ledger " + Model.Account.Code;
    string Amt(decimal v) => v == 0 ? "" : v.ToString("N2");
}
<main class="page">
  <p>
    <a asp-controller="Home" asp-action="Index">Home</a> |
    <a asp-controller="Ledger" asp-action="Index">Ledgers</a> |
    <a asp-controller="Journal" asp-action="New">New journal entry</a>
  </p>
  <h1 class="brand">Ledger: @Model.Account.Code - @Model.Account.Name</h1>

  @if (Model.Rows.Count == 0)
  {
    <p id="empty">No entries yet for this account.</p>
  }
  else
  {
    <div class="grid-wrap">
      <table class="grid">
        <thead>
          <tr>
            <th>Date</th><th>Reference</th><th>Description</th>
            <th class="num">Debit</th><th class="num">Credit</th><th class="num">Balance</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var row in Model.Rows)
          {
            <tr>
              <td>@row.Date.ToString("yyyy-MM-dd")</td>
              <td><a asp-controller="Journal" asp-action="Details" asp-route-id="@row.EntryId">@row.Reference</a></td>
              <td>@row.Description</td>
              <td class="num">@Amt(row.Debit)</td>
              <td class="num">@Amt(row.Credit)</td>
              <td class="num">@row.Balance.ToString("N2")</td>
            </tr>
          }
        </tbody>
        <tfoot>
          <tr>
            <td colspan="3">Total (balance = debit minus credit)</td>
            <td class="num">@Model.TotalDebit.ToString("N2")</td>
            <td class="num">@Model.TotalCredit.ToString("N2")</td>
            <td class="num">@Model.Balance.ToString("N2")</td>
          </tr>
        </tfoot>
      </table>
    </div>
  }
</main>
